# Copy this file to .env for local development and fill in real values.
# NEVER commit a real .env file — it's excluded in .gitignore.
# In production (Render), this variable is set through Render's Environment
# tab, not through a committed file.

# Neon Postgres connection string. The web app currently expects the
# app_readonly role's connection string here (see db/migrations/001_create_readonly_role.sql) —
# NOT the neondb_owner credential, per this project's read-only-role principle.
NEON_CONNECTION_STRING=
